	MushroomStaff: {
		DisplayName: Mushroom Staff
		Tooltip:
			'''
			Summons a mushroom boi to fight for you
			'Get Mushed Boi!'
			'''
	}

	BarrelLauncher: {
		DisplayName: Barrel Launcher
		Tooltip:
			'''
			Barrels deal more damage when bounced.
			'Derelict Distillery, 2020 Vintage'
			'''
	}

	KillingDeck: {
		DisplayName: Killing Deck
		Tooltip: "'A Dead Man's Hand for your opponents, mon chéri'"
	}

	Flint: {
		DisplayName: Flint
		Tooltip: "'A helping hand from a former prison warden, fallen to the Malaise'"
	}

	BarnacleStaff: {
		DisplayName: Barnacle Staff
		Tooltip:
			'''
			Summons a sentry
			Summons a hanging barnacle to poison enemies
			'''
	}

	RamRune: {
		DisplayName: Ram Rune
		Tooltip:
			'''
			Jump while holding DOWN to slam downward
			Slamming into the ground will deal damage to nearby enemies
			'Pound the ground like the heroes of old'
			'''
	}

	SwarmGrenade: {
		DisplayName: Swarm Grenade
		Tooltip:
			'''
			Summons a pet swarm biter
			'Careful, I hear they bite!'
			'''
	}

	ItemFlask: {
		DisplayName: Item Flask
		Tooltip:
			'''
			Right click to place item in item flask
			Press Up/Down to cycle through placement styles
			'Preserve your most treasured possessions within viscous fluids'
			'''
	}

	AlchemyFlask: {
		DisplayName: Alchemy Flask
		Tooltip:
			'''
			Usable when placed
			Fresh buffs last longer
			'A mysterious bottle from far away'
			'''
	}

	Cattiva: {
		DisplayName: Cattiva
		Tooltip:
			'''
			Summons Cattiva to fight for you
			A lovely pal that also helps your mining efforts
			Right click to pet it!
			'''
	}

	Foxparks: {
		DisplayName: Foxparks
		Tooltip:
			'''
			Summons Foxparks to fight for you
			Use to use Foxparks' Huggy Fire skill, shooting flames!
			Right click to pet it!
			'''
	}

	Chillet: {
		DisplayName: Chillet
		Tooltip:
			'''
			Summons Chillet for a ride!
			Empowers your attacks while mounted.
			Double tap a direction to use Rocket Slam!
			Right click to pet it!
			'''
	}

	ChilletIgnis: {
		DisplayName: Chillet Ignis
		Tooltip:
			'''
			Summons Chillet Ignis for a ride!
			Empowers your attacks while mounted.
			Double tap a direction to use Rocket Slam!
			Right click to pet it!
			'''
	}

	Digtoise: {
		DisplayName: Digtoise
		Tooltip:
			'''
			Summons Digtoise to help mining!
			Use to direct Digtoise
			Interact away to recall Digtoise
			Right click to pet it!
			'''
	}

	ChilletEgg: {
		DisplayName: Huge Dragon Egg
		Tooltip:
			'''
			May hatch into something wonderful!
			Right click to open
			'''
	}

	TrustyCattiva: {
		DisplayName: Trusty Cattiva
		Tooltip:
			'''
			Summons Trusty Cattiva to fight for you
			A lovely pal that also helps your mining efforts
			Right click to pet it!
			Its trust empowers it, and improved its 'Punch Flurry'!
			'''
	}

	TrustyFoxparks: {
		DisplayName: Trusty Foxparks
		Tooltip:
			'''
			Summons Trusty Foxparks to fight for you
			Use to use Foxparks' Huggy Fire skill, shooting flames!
			Right click to pet it!
			Its trust empowers it, and it learned 'Spirit Fire'!
			'''
	}

	TrustyChillet: {
		DisplayName: Trusty Chillet
		Tooltip:
			'''
			Summons Trusty Chillet for a ride!
			Empowers your attacks while mounted.
			Double tap a direction to use Rocket Slam!
			Right click to pet it!
			Its trust empowers it, and increases its speed!
			'''
	}

	TrustyChilletIgnis: {
		DisplayName: Trusty Chillet Ignis
		Tooltip:
			'''
			Summons Trusty Chillet Ignis for a ride!
			Empowers your attacks while mounted.
			Double tap a direction to use Rocket Slam!
			Right click to pet it!
			Its trust empowers it, and increases its speed!
			'''
	}

	TrustyDigtoise: {
		DisplayName: Trusty Digtoise
		Tooltip:
			'''
			Summons Trusty Digtoise to help mining!
			Use to direct Digtoise
			Interact away to recall Digtoise
			Right click to pet it!
			Its trust empowers it, and it now matches your pickaxe power!
			'''
	}

	LittleKinshipPeach: {
		DisplayName: Little Kinship Peach
		Tooltip:
			'''
			A small fruit filled with kindness
			It is said that a Pal who eats it will open its heart to humans
			Choose carefully which Pal you give it to
			'''
	}

